PORT=3000
VERIFY_TOKEN=replace-with-random-verify-token
INSTAGRAM_ACCOUNT_ID=your-instagram-bot-id
REPLY_MODE=shadow
TEST_USER_IDS=
PUBLIC_BASE_URL=https://carlotes.ganxo.net
CREATOR_FOLLOWER_THRESHOLD=5000
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
NOTIFY_NON_REEL_MESSAGES=true
LOG_ONLY_WEBHOOKS=1

# Instagram OAuth (Business Login)
IG_APP_ID=your-instagram-app-id
IG_APP_SECRET=your-instagram-app-secret
IG_REDIRECT_URI=https://your-domain.com/auth/instagram/callback
IG_LOGIN_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish,instagram_business_manage_insights